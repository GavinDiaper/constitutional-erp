PORT=4008
NODE_ENV=development
DATABASE_PATH=user-identity.db
JWT_ISSUER=constitutionalerp-user-identity
JWT_AUDIENCE=constitutionalerp-clients
JWT_SIGNING_SECRET=change-me-signing-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_SECRET=change-me-admin-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
OAUTH_MOCK_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4008/auth/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4008/auth/callback/microsoft
APPLE_CLIENT_ID=
