              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET canonical resource",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/graph/p2p/requisition/{{requisitionId}}",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-actor-id", "value": "{{actorId}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('requisitionId is resolved', () => pm.expect(pm.environment.get('requisitionId')).to.be.a('string').and.not.empty);",
                  "pm.test('Status 200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has canonical shape', () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.id).to.exist;",
                  "    pm.expect(b.domain).to.eql('P2P');",
                  "    pm.expect(b.type).to.eql('requisition');",
                  "    pm.expect(b.state).to.exist;",
                  "    pm.expect(b.links).to.exist;",
                  "    pm.expect(b.links.self).to.exist;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
