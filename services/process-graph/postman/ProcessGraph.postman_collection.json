      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service ok', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('ok'); pm.expect(b.service).to.eql('process-graph'); });"
                ]
              }
            }
          ]
        }
      ]
