    {
      "name": "20 – MCP Discovery",
      "item": [
        {
          "name": "GET /mcp/functions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp/functions",
              "host": ["{{baseUrl}}"],
              "path": ["mcp", "functions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has version and functions array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('version');",
                  "  pm.expect(json.functions).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('Each function has id, name, description, domain', () => {",
                  "  const json = pm.response.json();",
                  "  json.functions.forEach(fn => {",
                  "    pm.expect(fn).to.include.keys('id', 'name', 'description', 'domain', 'aggregateType', 'action', 'operationType', 'inputSchema', 'backingRoute');",
                  "  });",
                  "  const preferred = json.functions.find(fn => fn.id === 'r2r_post_journal') || json.functions[0];",
                  "  if (preferred && preferred.id) pm.environment.set('mcpFunctionId', preferred.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /mcp/functions/:id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp/functions/{{mcpFunctionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mcp", "functions", "{{mcpFunctionId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Function id matches request', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.environment.get('mcpFunctionId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /mcp/functions/:id – unknown (404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp/functions/unknown_function_id",
