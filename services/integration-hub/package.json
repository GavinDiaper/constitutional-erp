{
  "name": "integration-hub",
  "version": "0.1.0",
  "description": "Constitutional ERP Integration Hub",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node scripts/start-server.js",
    "migrate": "node -e \"process.exit(0)\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:integration",
    "test:integration": "tsx --test test/**/*.test.ts",
    "test:postman": "node scripts/run-postman.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "newman": "^6.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
