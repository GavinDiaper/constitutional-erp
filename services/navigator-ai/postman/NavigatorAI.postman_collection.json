      "name": "20 - Navigator",
      "item": [
        {
          "name": "SETUP Create P2P requisition fixture",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-ingress-id", "value": "{{ingressId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requester\": \"navigator-ai.postman\"\n}"
            },
            "url": {
              "raw": "{{foundationBaseUrl}}/api/v1/p2p/requisitions",
              "host": ["{{foundationBaseUrl}}"],
              "path": ["api", "v1", "p2p", "requisitions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Fixture created (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Requisition id captured', () => pm.expect(json.requisition_id).to.be.a('string').and.not.empty);",
                  "pm.environment.set('domain', 'P2P');",
                  "pm.environment.set('aggregateType', 'requisition');",
                  "pm.environment.set('aggregateId', json.requisition_id);"
                ]
              }
            }
          ]
        },
