{
  "name": "constitutional-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "migrate": "turbo run migrate",
    "dev": "turbo run dev --parallel",
    "dev:erp-mapping-tool": "npm --workspace services/erp-mapping-tool-api run dev",
    "dev:erp-mapping-ui": "npm --workspace apps/ERPMappingTool run dev",
    "start:erp-mapping-tool": "node ./infra/scripts/run-erp-mapping-tool.js",
    "start:all": "node ./infra/scripts/run-systems.js start",
    "stop:all": "node ./infra/scripts/run-systems.js stop",
    "health:all": "node ./infra/scripts/run-systems.js health",
    "docker:rebuild": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/run-docker-postman-cycle.ps1 -SkipPostman",
    "docker:retest": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/run-docker-postman-cycle.ps1",
    "docker:resetdb": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/reset-docker-service-databases.ps1",
    "postman:build": "node postman/build-unified-postman.js",
    "postman:test": "node postman/newman/run-newman.js all",
    "postman:test:projects-r2r-reporting": "node postman/newman/run-newman.js foundation-projects-r2r-reporting",
    "postman:seed:uea-starter": "node postman/newman/run-newman.js foundation-uea-starter"
  },
  "devDependencies": {
    "turbo": "^2.1.1"
  }
}