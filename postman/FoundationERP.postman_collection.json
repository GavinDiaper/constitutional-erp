      "item": [
        {
          "name": "GET O2C Customers - Missing ingress header",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/o2c/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "o2c",
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403 for missing ingress identity\", function () { pm.response.to.have.status(403); });",
                  "var body = pm.response.json();",
                  "pm.test(\"Problem title indicates ingress failure\", function () {",
                  "  pm.expect(body.title).to.eql(\"forbidden_ingress\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET O2C Customers - Missing API key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-ingress-id",
                "value": "{{ingressId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/o2c/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "o2c",
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 for missing API key\", function () { pm.response.to.have.status(401); });",
                  "var body = pm.response.json();",
                  "pm.test(\"Problem title indicates auth failure\", function () {",
