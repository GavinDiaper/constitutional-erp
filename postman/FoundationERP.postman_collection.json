          "if (!pm.environment.get('collectionInitialized')) {",
          "  [",
          "    'customerId','quoteId','orderId','invoiceId','paymentId',",
          "    'supplierId','requisitionId','poId','receiptId','supplierInvoiceId','apPaymentId',",
          "    'accountId','fiscalYearId','fiscalPeriodId','journalId'",
          "  ].forEach(function (k) { pm.environment.unset(k); });",
          "  pm.environment.set('collectionInitialized', 'true');",
          "}"
        ]
      }
    }
