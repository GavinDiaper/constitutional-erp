{
  "name": "mesh-gateway",
  "version": "0.1.0",
  "description": "Constitutional ERP Mesh Gateway",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node scripts/start-server.js",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:integration",
    "test:integration": "tsx --test test/**/*.test.ts",
    "test:postman": "node scripts/run-postman.js",
    "test:p2p:mesh": "node tests/mesh/run-p2p.js",
    "test:o2c:mesh": "node tests/mesh/run-o2c.js",
    "test:r2r:mesh": "node tests/mesh/run-r2r.js",
    "test:h2r:mesh": "node tests/mesh/run-h2r.js",
    "test:mesh:all": "node tests/mesh/run-all.js",
    "test:step7:p2p": "node tests/mesh/step7-p2p.js",
    "test:step7:o2c": "node tests/mesh/step7-o2c.js",
    "test:step7:r2r": "node tests/mesh/step7-r2r.js",
    "test:step7:h2r": "node tests/mesh/step7-h2r.js",
    "test:step7": "node tests/mesh/step7-all.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.0",
    "newman": "^6.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
