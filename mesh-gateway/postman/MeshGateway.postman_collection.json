  "item": [
    {
      "name": "00 – P2P Setup (Foundation ERP fixture)",
      "description": "Creates a Supplier → Requisition (submit → approve → convert to PO) directly against Foundation ERP. Captures supplierId, requisitionId, and poId as environment variables for use in the mesh tests below.",
      "item": [
        {
          "name": "Create Supplier",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-ingress-id", "value": "{{ingressId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierName\": \"Mesh Test Supplier\",\n  \"email\": \"ap@mesh-test.local\"\n}"
            },
            "url": {
              "raw": "{{foundationBaseUrl}}/api/v1/p2p/suppliers",
              "host": ["{{foundationBaseUrl}}"],
              "path": ["api", "v1", "p2p", "suppliers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set(\"supplierId\", body.supplier_id);",
                  "pm.test(\"supplierId captured\", function () { pm.expect(body.supplier_id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Requisition",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-ingress-id", "value": "{{ingressId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requester\": \"mesh.test.user\"\n}"
            },
            "url": {
              "raw": "{{foundationBaseUrl}}/api/v1/p2p/requisitions",
              "host": ["{{foundationBaseUrl}}"],
              "path": ["api", "v1", "p2p", "requisitions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set(\"requisitionId\", body.requisition_id);",
                  "pm.test(\"Requisition in Draft\", function () { pm.expect(body.state).to.eql(\"Draft\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Requisition",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-ingress-id", "value": "{{ingressId}}" }
            ],
            "url": {
              "raw": "{{foundationBaseUrl}}/api/v1/p2p/requisitions/{{requisitionId}}/submit",
              "host": ["{{foundationBaseUrl}}"],
              "path": ["api", "v1", "p2p", "requisitions", "{{requisitionId}}", "submit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Submitted\", function () { pm.expect(pm.response.json().state).to.eql(\"Submitted\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Requisition",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-ingress-id", "value": "{{ingressId}}" }
            ],
            "url": {
              "raw": "{{foundationBaseUrl}}/api/v1/p2p/requisitions/{{requisitionId}}/approve",
              "host": ["{{foundationBaseUrl}}"],
              "path": ["api", "v1", "p2p", "requisitions", "{{requisitionId}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Approved\", function () { pm.expect(pm.response.json().state).to.eql(\"Approved\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Convert Requisition to PO",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "x-ingress-id", "value": "{{ingressId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\"\n}"
            },
            "url": {
              "raw": "{{foundationBaseUrl}}/api/v1/p2p/requisitions/{{requisitionId}}/convert",
              "host": ["{{foundationBaseUrl}}"],
              "path": ["api", "v1", "p2p", "requisitions", "{{requisitionId}}", "convert"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.environment.set(\"poId\", body.po_id);",
                  "pm.test(\"PO in Draft\", function () { pm.expect(body.state).to.eql(\"Draft\"); });",
                  "pm.test(\"poId captured\", function () { pm.expect(body.po_id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
